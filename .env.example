# NEXT_PUBLIC_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Settings menu in the AI Studio UI.
NEXT_PUBLIC_GEMINI_API_KEY=

# Firebase Admin credentials. Server-only; never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=gen-lang-client-0185667970
FIREBASE_CLIENT_EMAIL=
# Keep escaped newlines when configured as one environment-variable value.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID=ai-studio-471779e6-3ac4-400d-910b-6a025a280090

# GROQ_API_KEY: Required for AI analysis (Groq API - free tier available).
# Sign up at https://console.groq.com to get your free API key.
GROQ_API_KEY=

# GEMINI_API_KEY: Server-only fallback for evaluation and text roleplay.
GEMINI_API_KEY=

# NVIDIA_NIM_API_KEY: Server-only fallback for AI analysis when Groq is unavailable.
# Create a fresh key at https://build.nvidia.com and never expose it as NEXT_PUBLIC_*.
NVIDIA_NIM_API_KEY=

# Optional override. Defaults to nvidia/nemotron-3-ultra-550b-a55b.
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenRouter is called only from the authenticated server route.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Optional reachable server-side Ollama deployment. Do not use a user-supplied URL.
OLLAMA_BASE_URL=

# Best-effort in-memory limits. Values apply per running server instance.
ANALYZE_RATE_LIMIT_MAX=10
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60
ROLEPLAY_TEXT_RATE_LIMIT_MAX=30
ROLEPLAY_TEXT_RATE_LIMIT_WINDOW_SECONDS=60

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
